                    <header class="article-meta">
                        <h1 class="font-medium fs-text-display-lg text-midnight-blue-500">REST API v3 Swagger Documentation</h1>
                        <p class="font-medium fs-text-eyebrow-sm text-uppercase text-core-blue-500 updated">Last updated &#8211; 28 July, 2026</p>
                        <aside class="docs-mobile-toc d-xxl-none mt-4 mb-4" data-swiftype-index="false">
                            <div class="docs-mobile-toc-container">
  <h6 class="fs-text-eyebrow-sm font-medium text-midnight-blue-300 font-mono docs-mobile-toc-title">
